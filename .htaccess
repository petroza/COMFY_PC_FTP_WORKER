Options -Indexes
DirectoryIndex index.html index.php comfy.php

# Chraň konfigy, databázi, WAL/SHM, tokeny, dokumentaci, workflow JSONy, skripty a archivy.
<FilesMatch "^(config\.php|db\.sqlite(?:-wal|-shm)?|install\.lock|README.*|NASADIT.*|NEPREPISUJE.*|PACKAGE_MANIFEST.*|UPDATE_.*|.*\.(sqlite|sqlite-wal|sqlite-shm|db|ini|env|py|pyc|bat|cmd|ps1|sh|log|lock|bak|old|tmp|txt|md|json|zip))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Zákaz přístupu k dotfiles kromě tohoto pravidla obslouženého Apachem.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
